[flake8]
# Max line length aligned with Black
max-line-length = 88

# Ignore specific warnings that conflict with Black formatting
extend-ignore = E203, W503

# Only lint relevant directories
# - src: your package code
# - tests: unit tests
# Exclude unnecessary directories and files
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    docs,
    .github

# Optional: show source code for errors in CI logs
show-source = True

# Optional: show statistics summary at the end of linting
statistics = True
